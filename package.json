  "license": "ISC",
  "description": "Trellis Backend",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cryptr": "^6.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "mongodb": "^6.21.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-elasticsearch": "^0.19.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
